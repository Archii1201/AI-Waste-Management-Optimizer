# =============================================================================
# AI-Powered Waste Management & Recycling Optimizer - environment template
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.
# =============================================================================

# ---------- Application ----------
APP_NAME="AI Waste Management & Recycling Optimizer"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ---------- Database ----------
# Cloud PostgreSQL (Neon / Supabase / RDS). The `+psycopg` driver is psycopg 3.
# Neon example:
#   postgresql+psycopg://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waste_optimizer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300              # Recycle connections; cloud PG drops idle ones.
DB_ECHO=false

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- MQTT (amqtt broker, pure Python) ----------
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=waste/bins/+/telemetry
MQTT_CLIENT_ID=waste-optimizer-bridge

# ---------- City / geography (seeded network) ----------
CITY_NAME=Mumbai
CITY_CENTER_LAT=19.0760
CITY_CENTER_LON=72.8777
CITY_TIMEZONE=Asia/Kolkata

# ---------- Operational thresholds ----------
BIN_FULL_THRESHOLD=85.0          # % fill treated as "needs collection"
BIN_CRITICAL_THRESHOLD=95.0      # % fill treated as "overflowing"
OVERFLOW_ALERT_HORIZON_HOURS=12  # Alert if predicted to overflow within N hours
ALERT_COOLDOWN_MINUTES=120       # Suppress duplicate alerts for the same bin

# ---------- Routing ----------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ENABLED=true                # Falls back to haversine distances if false/unreachable
DEFAULT_SERVICE_TIME_MINUTES=6   # Time spent emptying one bin
MAX_ROUTE_DURATION_MINUTES=480   # Vehicle shift length
ROUTE_SOLVER_TIME_LIMIT_SECONDS=30

# ---------- ML artifacts ----------
ML_ARTIFACT_DIR=ml/artifacts
FILL_MODEL_NAME=fill_rate_gbr
CLASSIFIER_MODEL_NAME=waste_mobilenetv3
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60   # Below this, flag for human review
