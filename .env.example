# =============================================================================
# EcoFlow AI — Intelligent Waste Operations
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.
# Never commit secrets or production credentials.
# =============================================================================

# ---------- Application ----------
APP_NAME=EcoFlow AI
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # Forced false when ENVIRONMENT=production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
# Local bind. Production/Docker must use HOST=0.0.0.0 and the platform PORT.
HOST=127.0.0.1
PORT=8000

# ---------- Database ----------
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/waste_optimizer
# Cloud (Neon / Supabase / Render / Railway). Leave the password out of git.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_ECHO=false

# ---------- Security ----------
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

# ---------- CORS ----------
# Comma-separated exact origins. Do not use *.
# Development (Vite on 5173; preview on 4173):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Production split hosting: set the deployed frontend origin.
# CORS_ORIGINS=https://your-frontend-domain.example.com
# Same-origin (FastAPI serving frontend/dist): leave CORS_ORIGINS empty.
# Localhost origins are ignored when ENVIRONMENT=production.

# ---------- MQTT (amqtt broker, pure Python) ----------
# Not required for dashboard Live Simulation (HTTP /simulation).
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=waste/bins/+/telemetry
MQTT_CLIENT_ID=waste-optimizer-bridge

# ---------- City / geography (seeded network) ----------
CITY_NAME=Mumbai
CITY_CENTER_LAT=19.0760
CITY_CENTER_LON=72.8777
CITY_TIMEZONE=Asia/Kolkata

# ---------- Operational thresholds ----------
BIN_FULL_THRESHOLD=85.0
BIN_CRITICAL_THRESHOLD=95.0
OVERFLOW_ALERT_HORIZON_HOURS=12
ALERT_COOLDOWN_MINUTES=120

# ---------- Telemetry interpretation ----------
COLLECTION_DROP_THRESHOLD_PCT=25.0
COLLECTION_RESIDUAL_MAX_PCT=25.0
TELEMETRY_FUTURE_TOLERANCE_MINUTES=5
SENSOR_STALE_HOURS=24
FILL_RATE_WINDOW_DAYS=7

# ---------- Routing ----------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ENABLED=true
DEFAULT_SERVICE_TIME_MINUTES=6
MAX_ROUTE_DURATION_MINUTES=480
ROUTE_SOLVER_TIME_LIMIT_SECONDS=30

# ---------- ML artifacts ----------
# Production weights live at these unchanged paths and are copied into Docker:
#   ml/artifacts/fill_rate_gbr.joblib
#   ml/artifacts/waste_mobilenetv3.pt
ML_ARTIFACT_DIR=ml/artifacts
FILL_MODEL_NAME=fill_rate_gbr
CLASSIFIER_MODEL_NAME=waste_mobilenetv3
CLASSIFIER_CONFIDENCE_THRESHOLD=0.60
CLASSIFIER_DATASET_DIR=ml/datasets/waste
CLASSIFIER_IMAGE_SIZE=224
UPLOAD_DIR=ml/uploads
MAX_UPLOAD_BYTES=8388608
